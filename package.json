{
  "name": "corpus-lens",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @corpus-lens/db run db:generate",
    "db:migrate": "pnpm --filter @corpus-lens/db run db:migrate",
    "db:seed": "pnpm --filter @corpus-lens/db run db:seed",
    "db:studio": "pnpm --filter @corpus-lens/db run db:studio",
    "ingest": "pnpm --filter @corpus-lens/api run ingest",
    "eval": "pnpm --filter @corpus-lens/api run eval",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
