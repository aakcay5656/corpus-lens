# Copy to .env and fill in. Every variable is validated with Zod at startup, so a
# missing or malformed value fails the process immediately instead of at first use.
# CLAUDE.md §7: a new variable is added here in the same step that introduces it.

# ---------------------------------------------------------------------------
# Database — consumed by docker-compose.yml and by the apps
# ---------------------------------------------------------------------------
POSTGRES_USER=corpus
POSTGRES_PASSWORD=corpus
POSTGRES_DB=rag
POSTGRES_PORT=5432

# Must agree with the four values above. Kept as a separate URL because Drizzle, the
# migration runner and the seed script all take a connection string.
DATABASE_URL=postgresql://corpus:corpus@localhost:5432/rag

# ---------------------------------------------------------------------------
# Corpus
# ---------------------------------------------------------------------------
# Directory the ingestion CLI walks. Nothing about the sample corpus is hard-coded:
# pointing this at another folder is the only change needed (CLAUDE.md §5).
# Note the nesting — the provided archive puts the documents in a `corpus` subfolder,
# and sample_questions.md sits outside it and must not be ingested.
CORPUS_DIR=./sample_dataset/corpus

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=3001
MCP_PORT=3002

# Where the browser and the MCP server reach the API.
API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Embeddings — Step 4
# ---------------------------------------------------------------------------
# Which provider produces vectors. Two real options, not one plus a test double:
#
#   openai         — text-embedding-3-small. What you want for real retrieval quality.
#   deterministic  — a local hashing-trick provider, no network and no key. Ingestion,
#                    search, the dashboard and the MCP tool all work with it, so the
#                    whole system can be run and demonstrated without an API key. It has
#                    no semantics: it matches shared vocabulary, not paraphrase, so never
#                    read retrieval quality off a run that used it.
#
# The two share the same input and batch limits on purpose, so an offline run fails
# wherever an online one would.
EMBEDDING_PROVIDER=deterministic

# Required only when EMBEDDING_PROVIDER=openai. The process refuses to start without it
# rather than failing partway through an ingestion run.
# OPENAI_API_KEY=sk-...

# Optional. The /v1/embeddings wire format is not exclusive to OpenAI, so the vendor is a
# URL rather than a code change. Leave unset for OpenAI itself. Examples:
#   OpenRouter    https://openrouter.ai/api/v1   (model: openai/text-embedding-3-small)
#   Azure OpenAI  https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   local vLLM    http://localhost:8000/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Must match the vector(n) column width in packages/db. Changing it needs a migration.
EMBEDDING_DIMENSIONS=1536
# Note the provider prefix some gateways require, e.g. openai/text-embedding-3-small.
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Generation — Step 7
# ---------------------------------------------------------------------------
# Only grounded answers need this. Search, ingestion and the dashboard all work without
# a chat model; asking a question is the one feature that fails without it.
#
# The model is Anthropic Claude, reached over the OpenAI /v1/chat/completions wire format
# rather than the official SDK — see packages/rag/src/openai-chat-provider.ts for why.
# Point CHAT_BASE_URL at any gateway that speaks it.
CHAT_MODEL=anthropic/claude-sonnet-5
# CHAT_BASE_URL=https://openrouter.ai/api/v1

# Falls back to OPENAI_API_KEY when unset, since one gateway key usually covers both
# embeddings and generation. Set it explicitly to use two different providers.
# CHAT_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Auth — Step 8
# ---------------------------------------------------------------------------
# Required, with no default. Every other setting in this file falls back to something
# sensible; a signing secret must not, because a default secret is a published secret.
# The two must differ: both tokens are JWTs signed by this server, and the only thing
# stopping a refresh token being replayed as an access token is the key it verifies under.
#
#   openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-replace-me-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=dev-only-refresh-secret-replace-me-with-openssl-rand-base64-48

# Access tokens are short-lived because they cannot be revoked before they expire — that
# is the cost of verifying them without a database round trip. The refresh token is the
# revocable half: it is stored hashed, rotated on every use, and reusing a rotated one
# revokes the whole family.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# The single browser origin allowed to send credentialed requests. Never "*" — the two are
# incompatible for credentialed CORS, and a wildcard would let any site read an
# authenticated response.
WEB_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Demo credentials created by `pnpm db:seed`
# ---------------------------------------------------------------------------
# These are deliberately real values, not placeholders: a reviewer must be able to copy
# this file to .env and log in without inventing anything. They are demo accounts on a
# local database and are repeated in the README. Change them for any real deployment.
#
# Re-running the seed is safe — it upserts, resetting the password and role rather than
# failing on the unique index.
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=admin-demo-pw-2026
SEED_USER_EMAIL=user@demo.local
SEED_USER_PASSWORD=user-demo-pw-2026
