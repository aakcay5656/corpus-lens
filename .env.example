# Copy to .env and fill in. Every variable is validated with Zod at startup, so a
# missing or malformed value fails the process immediately instead of at first use.
# CLAUDE.md §7: a new variable is added here in the same step that introduces it.

# ---------------------------------------------------------------------------
# Database — consumed by docker-compose.yml and by the apps
# ---------------------------------------------------------------------------
POSTGRES_USER=corpus
POSTGRES_PASSWORD=corpus
POSTGRES_DB=rag
POSTGRES_PORT=5432

# Must agree with the four values above. Kept as a separate URL because Drizzle, the
# migration runner and the seed script all take a connection string.
DATABASE_URL=postgresql://corpus:corpus@localhost:5432/rag

# ---------------------------------------------------------------------------
# Corpus
# ---------------------------------------------------------------------------
# Directory the ingestion CLI walks. Nothing about the sample corpus is hard-coded:
# pointing this at another folder is the only change needed (CLAUDE.md §5).
# Note the nesting — the provided archive puts the documents in a `corpus` subfolder,
# and sample_questions.md sits outside it and must not be ingested.
CORPUS_DIR=./sample_dataset/corpus

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=3001
MCP_PORT=3002

# Where the browser and the MCP server reach the API.
API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Providers — added in Steps 4 and 7
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Auth — added in Step 8
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Demo credentials created by `pnpm db:seed`
# ---------------------------------------------------------------------------
# These are deliberately real values, not placeholders: a reviewer must be able to copy
# this file to .env and log in without inventing anything. They are demo accounts on a
# local database and are repeated in the README. Change them for any real deployment.
#
# Re-running the seed is safe — it upserts, resetting the password and role rather than
# failing on the unique index.
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=admin-demo-pw-2026
SEED_USER_EMAIL=user@demo.local
SEED_USER_PASSWORD=user-demo-pw-2026
