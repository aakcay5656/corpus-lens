{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    // Node16 (not "node") because the packages expose subpath exports; the node10
    // resolver ignores an "exports" map. package.json says type=commonjs, so the emit
    // is still CJS and relative imports still need no file extension.
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  // drizzle.config.ts is checked but not emitted into dist — it is CLI input, not library
  // code, which is why it sits outside src/.
  "include": ["src/**/*.ts"],
  // db implements the retrieval port that rag defines (ports and adapters), so the
  // dependency points this way. rag still imports nothing from db.
  "references": [{ "path": "../shared" }, { "path": "../rag" }]
}
