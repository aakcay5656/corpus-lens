{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    // Node16 (not "node") because the packages expose subpath exports; the node10
    // resolver ignores an "exports" map. package.json says type=commonjs, so the emit
    // is still CJS and relative imports still need no file extension.
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  // Deliberately NOT referencing ../db. CLAUDE.md §4: retrieval receives a repository
  // interface so it can be unit-tested without a database.
  "references": [{ "path": "../shared" }]
}
